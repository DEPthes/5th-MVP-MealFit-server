# MealFit 크롤러 환경 변수
#
# 이 파일을 .env로 복사해 값을 채웁니다. .env는 커밋되지 않습니다.
#   cp .env.example .env
#
# 모든 변수는 MEALFIT_ 접두어를 씁니다 (app/settings.py의 env_prefix).
# 여기 없는 항목은 app/settings.py의 기본값을 그대로 씁니다.


# ─────────────────────────────────────────────────────────────
# DB — 서버(Spring)와 같은 인스턴스를 씁니다
# ─────────────────────────────────────────────────────────────

# 필수. 서버 application.properties의 DB 비밀번호와 같은 값입니다.
MEALFIT_DB_PASSWORD=

# 기본값을 쓰면 생략 가능 (localhost:3306/mealfit_test, root)
# MEALFIT_DB_HOST=localhost
# MEALFIT_DB_PORT=3306
# MEALFIT_DB_NAME=mealfit_test
# MEALFIT_DB_USER=root


# ─────────────────────────────────────────────────────────────
# 지오코딩 — 새 식당의 좌표를 구할 때만 필요
# ─────────────────────────────────────────────────────────────

# 카카오 REST API 키. 비워두면 지오코딩을 건너뛰고 좌표를 NULL로 둡니다.
# 좌표가 없으면 거리 계산도 불가능해 distance_to_*_gate가 NULL이 됩니다.
# 이미 적재된 식당은 DB에 있는 좌표를 재사용하므로 키가 없어도 됩니다.
MEALFIT_KAKAO_REST_API_KEY=


# ─────────────────────────────────────────────────────────────
# LLM 보조 매칭 — llm-match 명령을 쓸 때만 필요
# ─────────────────────────────────────────────────────────────

# 기본은 ollama(로컬)입니다. 쿼터·비용이 없고 메뉴 데이터가 밖으로 나가지 않습니다.
# 클라우드로 바꾸려면 gemini로 설정하고 아래 키를 채웁니다.
# MEALFIT_LLM_PROVIDER=ollama

# Gemini를 쓸 때만 필요. 서버 application.properties의 gemini.api-key와 같은 값입니다.
# MEALFIT_GEMINI_API_KEY=

# Ollama를 쓸 때, 모델 파일이 기본 위치가 아니면 서버 기동 시
# OLLAMA_MODELS 환경변수를 따로 지정해야 모델이 보입니다.
# MEALFIT_OLLAMA_BASE_URL=http://localhost:11434
# MEALFIT_OLLAMA_MODEL=gemma4:latest


# ─────────────────────────────────────────────────────────────
# 기준점 좌표
# ─────────────────────────────────────────────────────────────

# 명지대 정문(정류장) / 후문(도서관) 좌표입니다.
# app/settings.py에 기본값이 있고, 서버 ReferencePoint.java와 같은 값이라
# 보통 건드릴 필요가 없습니다. 바꾸려면 서버도 함께 바꿔야 합니다.
# MEALFIT_GATE_MAIN_LAT=37.579132
# MEALFIT_GATE_MAIN_LNG=126.923488
# MEALFIT_GATE_BACK_LAT=37.5807266
# MEALFIT_GATE_BACK_LNG=126.9244188

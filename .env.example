# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 절대 GitHub에 올리지 마세요. (.gitignore에 등록 필수)

# =====================================
# MySQL
# =====================================
MYSQL_ROOT_PASSWORD=여기에_강력한_루트_비밀번호
MYSQL_DATABASE=mealfit
MYSQL_USER=mealfit
MYSQL_PASSWORD=여기에_강력한_유저_비밀번호

# =====================================
# JWT
# =====================================
JWT_ISSUER=mealfit
# 최소 32자 이상의 랜덤 문자열. 아래 명령으로 생성:
#   openssl rand -base64 48
JWT_SECRET=여기에_랜덤_시크릿
# 밀리초 단위. 예: 3600000 = 1시간, 86400000 = 24시간
JWT_EXPIRATION=86400000

# =====================================
# Gemini API
# =====================================
GEMINI_API_KEY=여기에_Gemini_키
GEMINI_MODEL=gemini-3.5-flash

# =====================================
# NAVER CLOVA OCR
# =====================================
CLOVA_OCR_INVOKE_URL=여기에_CLOVA_OCR_URL
CLOVA_OCR_SECRET_KEY=여기에_CLOVA_OCR_시크릿

# =====================================
# 파일 업로드
# =====================================
FILE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
FILE_MAX_SIZE_BYTES=10485760

# =====================================
# CORS - 프론트엔드 주소를 쉼표로 구분해 나열
# =====================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://내프론트도메인.vercel.app

# =====================================
# 도메인 / HTTPS
# HTTPS 종료와 인증서 발급은 Nginx Proxy Manager(다른 호스트)가 담당한다.
# 이 VM에서는 별도 설정이 필요 없다 — NPM 쪽에서 Proxy Host를 만들 때
# api.도메인.com → 이 VM의 LAN IP:8080 으로 연결하면 된다.
# 참고용으로만 적어둔다 (APP_CORS_ALLOWED_ORIGINS에는 프론트 주소를 넣는 것이지
# 이 값을 넣는 게 아니다).
# =====================================
DOMAIN_NAME=api.내도메인.com

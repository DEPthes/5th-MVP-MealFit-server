# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 절대 GitHub에 올리지 마세요. (.gitignore에 등록 필수)

# =====================================
# MySQL
# =====================================
MYSQL_ROOT_PASSWORD=여기에_강력한_루트_비밀번호
MYSQL_DATABASE=mealfit
MYSQL_USER=mealfit
MYSQL_PASSWORD=여기에_강력한_유저_비밀번호

# =====================================
# JWT
# =====================================
JWT_ISSUER=mealfit
# 최소 32자 이상의 랜덤 문자열. 아래 명령으로 생성:
#   openssl rand -base64 48
JWT_SECRET=여기에_랜덤_시크릿
# 밀리초 단위. 예: 3600000 = 1시간, 86400000 = 24시간
JWT_EXPIRATION=86400000

# =====================================
# Gemini API
# =====================================
GEMINI_API_KEY=여기에_Gemini_키
GEMINI_MODEL=gemini-3.5-flash

# =====================================
# NAVER CLOVA OCR
# =====================================
CLOVA_OCR_INVOKE_URL=여기에_CLOVA_OCR_URL
CLOVA_OCR_SECRET_KEY=여기에_CLOVA_OCR_시크릿

# =====================================
# 파일 업로드
# =====================================
FILE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
FILE_MAX_SIZE_BYTES=10485760

# =====================================
# CORS - 프론트엔드 주소를 쉼표로 구분해 나열
#
# 주의사항
#  - 주소 끝에 슬래시(/)를 붙이지 말 것. 브라우저가 보내는 값에는 슬래시가 없다.
#    (혹시 붙여도 앱이 알아서 떼어내지만, 애초에 안 붙이는 게 맞다)
#  - 쉼표 뒤에 공백을 넣지 말 것.
#  - *.vercel.app 같은 와일드카드(*) 사용 가능 → PR 미리보기 주소까지 한 번에 허용
#  - 여기에는 "프론트 주소"를 넣는다. API 서버 주소(api.parkserver.xyz)가 아니다.
# =====================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://5th-mvp-mealfit-web.vercel.app,https://5th-mvp-mealfit-web-*.vercel.app

# =====================================
# 메일 (비밀번호 재설정)
#
# ⚠️ 이 값들을 비워두면 앱이 기동되지 않는다.
#    비밀번호 재설정 기능이 JavaMailSender를 필요로 하기 때문.
#
# MAIL_PASSWORD는 Gmail 로그인 비밀번호가 아니라 "앱 비밀번호"(16자리)다.
# 발급: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
# =====================================
MAIL_USERNAME=여기에_발송용_Gmail_주소
MAIL_PASSWORD=여기에_Gmail_앱_비밀번호

# 재설정 메일에 담길 링크의 앞부분. 프론트 배포 주소를 넣는다.
APP_PASSWORD_RESET_URL=https://5th-mvp-mealfit-web.vercel.app/reset-password

# =====================================
# 도메인 / HTTPS
# HTTPS 종료와 인증서 발급은 Nginx Proxy Manager(다른 호스트)가 담당한다.
# 이 VM에서는 별도 설정이 필요 없다 — NPM 쪽에서 Proxy Host를 만들 때
# api.도메인.com → 이 VM의 LAN IP:8080 으로 연결하면 된다.
# 참고용으로만 적어둔다 (APP_CORS_ALLOWED_ORIGINS에는 프론트 주소를 넣는 것이지
# 이 값을 넣는 게 아니다).
# =====================================
DOMAIN_NAME=api.내도메인.com

spring.application.name=MVP-MealFit

# 이 파일은 GitHub에 업로드하지 않는 application.properties의 예시 파일입니다.
# 아래 공통 설정을 application.properties로 복사해서 사용하세요.
#
# 새로운 기능(JWT, OpenAI, OAuth 등)을 구현하면서 필요한 설정이 추가되면
# application.properties.example에도 예시를 함께 추가하여 팀원들과 공유해주세요.

# JPA (공통 설정)
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# =========================
# Database (개인 설정 예시)
# =========================
# spring.datasource.url=
# spring.datasource.username=
# spring.datasource.password=

# =========================
# JWT (예시)
# =========================
# jwt.issuer=
# jwt.secret=
# jwt.expiration=

# =========================
# Gemini API
# =========================
# gemini.api-key=
# gemini.model=gemini-3.5-flash

# ===========================
# File Upload (예시)
# ===========================
# file.allowed-extensions=
# file.max-size-bytes=
# file.root-path=

# ===========================
# Multipart File (예시)
# ===========================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# =========================
# NAVER CLOVA API (예시)
# =========================
clova.ocr.invoke-url=
clova.ocr.secret-key=

# =========================
# CORS - 프론트엔드 주소 허용 목록 (쉼표 구분, 끝에 / 붙이지 말 것)
# 값을 비워두면 CorsConfig의 기본 목록(localhost:3000/5173, Vercel 주소)이 쓰인다.
# 배포 서버에서는 환경변수 APP_CORS_ALLOWED_ORIGINS 로 덮어쓴다.
# =========================
# app.cors.allowed-origins=http://localhost:3000,http://localhost:5173

# =========================
# Email SMTP (예시)
# =========================
# 주의: .properties 파일은 값 뒤에 # 주석을 붙일 수 없습니다.
# 그 뒤 텍스트까지 값의 일부로 읽혀서 메일 발송이 깨지므로, 주석은 항상 별도 줄로 씁니다.
# 아래 두 값은 배포 서버의 환경변수(MAIL_USERNAME / MAIL_PASSWORD)에서 채워집니다.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=3000
spring.mail.properties.mail.smtp.writetimeout=5000
app.password-reset-url=http://localhost:3000/reset-password
